{
  "name": "aiworkflow",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件：流程图驱动的分步执行（DSH 单宿主）",
  "type": "module",
  "scripts": {
    "build": "node dsh-plugin/build.mjs",
    "build:plugin": "node dsh-plugin/build.mjs",
    "check:plugin": "node dsh-plugin/check-bundles.mjs",
    "market:plugin": "node dsh-plugin/market/build.mjs",
    "release:plugin": "node dsh-plugin/release.mjs",
    "typecheck": "npm run typecheck:plugin",
    "typecheck:plugin": "tsc -p shared/tsconfig.json --noEmit && tsc -p dsh-plugin/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "workflow",
    "flowchart"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
