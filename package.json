{
  "name": "dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件集合：每个 plugins/<id>/ 是一个独立安装的插件包",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --all",
    "build:plugin": "node scripts/build.mjs --all",
    "check": "npm run typecheck && npm test && npm run check:plugin && npm run check:docs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:plugin": "node scripts/check-bundles.mjs",
    "market:plugin": "node scripts/market.mjs",
    "release:plugin": "node scripts/release.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:plugin": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
